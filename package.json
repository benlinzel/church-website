{
  "name": "church-website-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev:site": "pnpm -C nextjs-app dev",
    "dev:studio": "pnpm -C sanity-cms dev",
    "build:site": "pnpm -C nextjs-app build",
    "build:studio": "pnpm -C sanity-cms build",
    "lint": "pnpm -C nextjs-app lint",
    "login:studio": "pnpm -C sanity-cms exec sanity login",
    "deploy:studio": "pnpm -C sanity-cms deploy",
    "backup:sanity": "bash scripts/backup-sanity.sh"
  }
}
